{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "98-pink-vue": ["./src/index.ts"]
    }
  },
  "include": ["demo/src/**/*.ts", "demo/src/**/*.vue", "demo/**/*.ts", "src/**/*.ts", "src/**/*.vue", "env.d.ts"]
}
