{
  "name": "98-pink.css",
  "version": "0.2.0",
  "description": "一套兼顾情怀&还原度&可爱的经典UI复刻方案 — the single source of truth for 98-ui styling, including the additive sheets the React and Vue ports consume.",
  "license": "MIT",
  "author": "Meorion <me@meorion.moe>",
  "contributors": [
    "Jordan Scales <scalesjordan@gmail.com>"
  ],
  "main": "dist/98-pink.css",
  "style": "dist/98-pink.css",
  "exports": {
    ".": "./dist/98-pink.css",
    "./98-pink.css": "./dist/98-pink.css",
    "./98-pink.raw.css": "./dist/98-pink.raw.css",
    "./98-pink.full.css": "./dist/98-pink.full.css",
    "./index.css": "./index.css",
    "./style.css": "./style.css",
    "./additive/*": "./additive/*",
    "./icon/*": "./icon/*",
    "./fonts/*": "./fonts/*",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.css",
    "style.css",
    "additive",
    "icon",
    "fonts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node build.js",
    "dev": "node server.js",
    "deploy:docs": "bun run build && gh-pages -d dist",
    "release": "bun run build && npm publish",
    "test": "node scripts/verify-build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meorionel/98-pink.css.git"
  },
  "keywords": [
    "css",
    "windows98",
    "pink",
    "ui"
  ],
  "bugs": {
    "url": "https://github.com/meorionel/98-pink.css/issues"
  },
  "homepage": "https://github.com/meorionel/98-pink.css",
  "trustedDependencies": [
    "fsevents"
  ],
  "devDependencies": {
    "chokidar": "^3.3.1",
    "cssnano": "^5.0.1",
    "dedent": "^0.7.0",
    "ejs": "^3.0.2",
    "gh-pages": "^2.2.0",
    "glob": "^7.1.6",
    "highlight.js": "^10.4.1",
    "live-server": "^1.2.1",
    "mkdirp": "^1.0.4",
    "postcss": "catalog:",
    "postcss-calc": "catalog:",
    "postcss-copy": "^7.1.0",
    "postcss-css-variables": "^0.14.0",
    "postcss-inline": "^1.2.0",
    "postcss-inline-svg": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-ejs": "^1.0.3"
  }
}
